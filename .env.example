# Exceptional Homes "Request Availability" endpoint (api/request-availability).
# Set these in your host's dashboard (Vercel → Project → Settings → Environment
# Variables, Netlify / Cloudflare equivalents). Never commit real values.

# GoHighLevel Inbound Webhook URL (Automation → Workflows → trigger "Inbound Webhook").
# Treat it as a secret: anyone with it can create contacts in your GHL account.
GHL_INQUIRY_WEBHOOK_URL=

# Where the GHL workflow sends the notification email ({{notify_to}}).
# Defaults to Reservations@WhataHotel.com. Use a TEST inbox until a live send is approved.
INQUIRY_TO=

# Pages allowed to call the endpoint from another origin (comma-separated).
# Same-origin requests are always allowed. Example:
# ALLOWED_ORIGINS=https://pro.whatahotel.com,https://rawcdn.githack.com
ALLOWED_ORIGINS=

# "ghl" (default) delivers to the webhook. "log" records without sending — for local
# testing only; it is refused on production deployments.
INQUIRY_DELIVERY=
